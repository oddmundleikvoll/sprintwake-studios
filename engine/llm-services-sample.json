{
  "services": [
    {
      "id": "cloud-openai-compatible",
      "label": "Hosted OpenAI-compatible model",
      "kind": "openai-compatible",
      "url": "https://provider.example/v1",
      "model": "provider-model",
      "vision": false
    },
    {
      "id": "local-ollama",
      "label": "Local Ollama model",
      "kind": "ollama",
      "url": "http://127.0.0.1:11434",
      "model": "local-model",
      "vision": false,
      "lifecycle": "ollama",
      "lifecycleTimeout": 720
    }
  ]
}
